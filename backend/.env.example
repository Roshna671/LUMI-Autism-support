# LUMI Backend Configuration
PROJECT_NAME="LUMI Adaptive Developmental Platform"
ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Security & Authentication
# Generate in prod using: openssl rand -hex 32
SECRET_KEY="lumi_dev_secret_key_change_in_production_min32chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: SQLite for seamless local dev; set to PostgreSQL for production
# DATABASE_URL="postgresql+psycopg2://lumi_user:lumi_password@localhost:5432/lumi_db"
DATABASE_URL="sqlite:///./lumi_development.db"

# Private Clinical Document Vault
STORAGE_VAULT_PATH="./vault"
MAX_UPLOAD_SIZE_BYTES=15728640  # 15 MB

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://*.vercel.app"]

# Voice & AI Companion Ephemeral Credentials
AI_VOICE_PROVIDER="lumi_conversational_engine"
AI_API_KEY=""
